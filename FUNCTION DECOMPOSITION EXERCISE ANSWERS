from datetime import datetime

def validate_inputs(sales_data, report_type, output_format, date_range):
    if not sales_data or not isinstance(sales_data, list):
        raise ValueError("Sales data must be a non-empty list")
    if report_type not in ['summary','detailed','forecast']:
        raise ValueError("Invalid report_type")
    if output_format not in ['pdf','excel','html','json']:
        raise ValueError("Invalid output_format")
    if date_range:
        if 'start' not in date_range or 'end' not in date_range:
            raise ValueError("Date range must include start and end")
        if datetime.strptime(date_range['start'],'%Y-%m-%d') > datetime.strptime(date_range['end'],'%Y-%m-%d'):
            raise ValueError("Start date cannot be after end date")

def filter_by_date_range(sales_data, date_range):
    if not date_range: return sales_data
    start = datetime.strptime(date_range['start'],'%Y-%m-%d')
    end = datetime.strptime(date_range['end'],'%Y-%m-%d')
    return [s for s in sales_data if start <= datetime.strptime(s['date'],'%Y-%m-%d') <= end]

def apply_filters(sales_data, filters):
    if not filters: return sales_data
    filtered = sales_data
    for key,value in filters.items():
        if isinstance(value, list):
            filtered = [s for s in filtered if s.get(key) in value]
        else:
            filtered = [s for s in filtered if s.get(key) == value]
    return filtered

def calculate_metrics(sales_data):
    total = sum(s['amount'] for s in sales_data)
    return {
        'total_sales': total,
        'avg_sale': total/len(sales_data),
        'max_sale': max(sales_data, key=lambda x: x['amount']),
        'min_sale': min(sales_data, key=lambda x: x['amount']),
        'count': len(sales_data)
    }

def group_sales_data(sales_data, grouping, total_sales):
    if not grouping: return None, None
    grouped={}
    for sale in sales_data:
        key=sale.get(grouping,'Unknown')
        grouped.setdefault(key,{'count':0,'total':0,'items':[]})
        grouped[key]['count']+=1
        grouped[key]['total']+=sale['amount']
        grouped[key]['items'].append(sale)
    for k in grouped: grouped[k]['average']=grouped[k]['total']/grouped[k]['count']
    # Format for report
    report_group={'by':grouping,'groups':{k:{'count':v['count'],'total':v['total'],'average':v['average'],'percentage':(v['total']/total_sales)*100} for k,v in grouped.items()}}
    return grouped, report_group

def build_detailed_transactions(sales_data):
    transactions=[]
    for sale in sales_data:
        t={**sale}
        if 'tax' in sale: t['pre_tax']=sale['amount']-sale['tax']
        if 'cost' in sale:
            t['profit']=sale['amount']-sale['cost']
            t['margin']=(t['profit']/sale['amount'])*100
        transactions.append(t)
    return transactions

def build_forecast(sales_data):
    monthly={}
    for sale in sales_data:
        d=datetime.strptime(sale['date'],'%Y-%m-%d')
        mk=f"{d.year}-{d.month:02d}"
        monthly[mk]=monthly.get(mk,0)+sale['amount']
    sorted_months=sorted(monthly.keys())
    growth=[]
    for i in range(1,len(sorted_months)):
        prev, curr = monthly[sorted_months[i-1]], monthly[sorted_months[i]]
        if prev>0: growth.append(((curr-prev)/prev)*100)
    avg_growth=sum(growth)/len(growth) if growth else 0
    forecast={}
    if sorted_months:
        last_month=sorted_months[-1]
        last_amt=monthly[last_month]
        y,m=map(int,last_month.split('-'))
        for _ in range(3):
            m+=1
            if m>12: m=1; y+=1
            fm=f"{y}-{m:02d}"
            forecast[fm]=last_amt*(1+avg_growth/100)
            last_amt=forecast[fm]
    return {'monthly_sales':monthly,'average_growth_rate':avg_growth,'projected_sales':forecast}

def build_charts(sales_data, grouped_data, grouping):
    date_sales={}
    for s in sales_data: date_sales[s['date']]=date_sales.get(s['date'],0)+s['amount']
    charts={'sales_over_time':{'labels':sorted(date_sales.keys()),'data':[date_sales[d] for d in sorted(date_sales.keys())]}}
    if grouping and grouped_data:
        charts[f'sales_by_{grouping}']={'labels':list(grouped_data.keys()),'data':[v['total'] for v in grouped_data.values()]}
    return charts

