def test_urgent_task():
    # 3*20=60 + due 1 day +30 =90
    task={'importance':3,'days_until_due':1,'days_since_update':0}
    assert calculateTaskScore(task)==90

def test_due_date_boundary():
    base={'importance':2,'days_since_update':0}
    assert calculateTaskScore({**base,'days_until_due':1})==70 # 40+30
    assert calculateTaskScore({**base,'days_until_due':3})==55 # 40+15
    assert calculateTaskScore({**base,'days_until_due':4})==40 # no boost
