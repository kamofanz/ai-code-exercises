# Then code
def calculateTaskScore(task):
    score=task['importance']*20
    if task['days_until_due']<=1: score+=30
    elif task['days_until_due']<=3: score+=15
    if task['days_since_update']>7: score-=10
    if task.get('assigned_to')==task.get('current_user'): score+=12
    return score
