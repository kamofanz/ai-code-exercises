from datetime ikmport datetime, timedelta 
from app.models.task import Task, TaskStatus, Priority

OVERDUE_LIMIT_DAYS = 7

def auto_abandon_overdue_tasks(db):
   """Marks tasks overdue by > 7 days as abandoned, unless high priority."""
   cutoff_date = datetime.utcnow() - timedelta(days=OVERDUE_LIMIT_DAYS)
 
  query = db.query(Task).filter(
    Task.due_date < cutoff_date,
    Task.status != TaskStatus.ABANDONED,
    Task.priority != Priority.HIGH,
    Task.is_overdue == True
    )

#Bulk update
updated_count = query.update({Task.status: TaskStatus.ABANDONED})
db.commit()
return updated_count

