def discount(cart, promos, user):
    """
    Calculates best discount for e-commerce cart.
    
    What it does:
        1. Calculates cart total
        2. Checks all promos and loyalty status
        3. Returns best discount (max) + free shipping flag
    
    Params:
        cart: List of {'price': float, 'quantity': int}
        promos: List of {'type':'percent'/'fixed'/'shipping', 'value':float, 'min_purchase':float|None}
        user: {'status':'vip'/'member'/'regular', 'months':int}
    
    Returns:
        {'original': total, 'discount': best, 'final': total-best, 'free_shipping': bool}
    """

    # 1. Calculate total
    total = 0
    for item in cart:
        total += item['price'] * item['quantity']

    best_discount = 0

    # 2. Apply promo discounts
    for promo in promos:
        # Check minimum purchase requirement
        if promo['min_purchase'] is not None and total < promo['min_purchase']:
            continue

        if promo['type'] == 'percent':
            discount_value = total * promo['value'] / 100
            best_discount = max(best_discount, discount_value)

        elif promo['type'] == 'fixed':
            discount_value = min(promo['value'], total)
            best_discount = max(best_discount, discount_value)

        elif promo['type'] == 'shipping':
            user['free_shipping'] = True

    # 3. Apply loyalty discount
    if user['status'] == 'vip':
        vip_discount = total * 0.05
        best_discount = max(best_discount, vip_discount)

    elif user['status'] == 'member' and user['months'] > 6:
        member_discount = total * 0.02
        best_discount = max(best_discount, member_discount)

    return {
        'original': total,
        'discount': best_discount,
        'final': total - best_discount,
        'free_shipping': user.get('free_shipping', False)
    }
